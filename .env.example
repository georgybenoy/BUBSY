# ==============================================================================
# Bubsy Configuration Template
# NOTE: This file contains placeholders only. Copy to .env and adjust as needed.
# Do NOT commit actual secrets or real student data.
# ==============================================================================

# Application & Environment
APP_NAME=Bubsy Handwashing Guidance System
APP_ENV=development
LOG_LEVEL=INFO

# Network Binding (Must bind to 127.0.0.1 for local kiosk security)
HOST=127.0.0.1
PORT=8000

# Security (Required: set a secure random string in production)
SECRET_KEY=your-secure-random-secret-key-placeholder-min-32-chars

# CORS (Allowed frontend origins: JSON list or comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Database (Local SQLite)
DATABASE_URL=sqlite:///./bubsy.db

# AI Vision Model
MODEL_PATH=models/bubsy_yolo_v1.pt
MODEL_VERSION=1.0.0

# Frontend Environment Variables (Exposed via Vite)
VITE_API_URL=http://127.0.0.1:8000
